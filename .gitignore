# generated toolchain (re-fetch with xwin)
toolchain/xwin-sdk/
toolchain/.xwin-cache/

# build outputs / console pulls / packed MSIX
artifacts/
*.msix
*.exe
*.dll
!corpus/shims/**
!src/**/*.cpp
gh_gp_harness.exe

# fetched third-party binaries
corpus/bin/
corpus/downloads/
corpus/redist/

# Microsoft MSIX packaging clone + Windows SDK bits (~600MB)
toolchain/msix-packaging-src/
toolchain/sdk-buildtools/

# BoxedWine clone (~173MB, GPL-2.0). Not vendored: our entire divergence from
# upstream is toolchain/boxedwine.patch (311 lines, 8 files), and
# toolchain/build_bwjit.sh clones the pinned commit and applies it. Keeps the
# repo small and keeps the licence line honest -- the patch is ours, the tree
# is theirs.
toolchain/boxedwine/

# NEVER commit these
toolchain/signing/*.pfx
toolchain/signing/*.key
toolchain/winvm/*ed25519
!toolchain/winvm/*.pub

# Steam / session leftovers
**/gh_cred.txt
# Steam QR LOGIN images. Scanning one authorises a session on the account, so
# these are credentials with a short fuse, not screenshots. They are written
# wherever a login run happens to be driven from, hence the loose glob.
**/steam_qr*.png
**/gh_qr*.png
**/steamclient64.dll
**/tier0_s64.dll
**/vstdlib_s64.dll

# Claude Code session-local state: a runtime lock holding a pid/sessionId, and
# machine-local tool permissions. Neither is repo content.
.claude/

# scratch pull of the Windows Device Portal reference page
.wdp_ref.html

# vmdiff build outputs -- toolchain/vmdiff/build.sh regenerates all of it
# (kernel32.def is generated from the SDK, kernel32.lib by llvm-dlltool).
toolchain/vmdiff/build/

# editor / build junk
*.obj
*.pdb
*.ilk
__pycache__/
*.pyc
.venv/
.grok/

# Session status notes written for the user mid-run. Prose about the state of a
# task, not repo content -- GREENHOUSE.md is where anything durable goes.
claudeghostbtw
claudespidey*
tester_logs/
