<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  IgnorableNamespaces="uap mp">

  <Identity
    Name="Greenhouse.Launcher"
    Publisher="CN=Greenhouse"
    Version="0.0.452.0"
    ProcessorArchitecture="x64" />

  <mp:PhoneIdentity PhoneProductId="c2d8e531-7e4b-4a29-8c3d-6b5f1e4a7d22" PhonePublisherId="00000000-0000-0000-0000-000000000000"/>

  <Properties>
    <DisplayName>Greenhouse Launcher</DisplayName>
    <PublisherDisplayName>Greenhouse</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Xbox" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="p0_spike_host.exe" EntryPoint="Greenhouse.Launcher.App">
      <uap:VisualElements
        DisplayName="Greenhouse Launcher"
        Description="On-device launcher for the Greenhouse Steam-game runtime (Xbox Dev Mode)"
        BackgroundColor="#0E1116"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <Capability Name="internetClientServer" />
    <Capability Name="privateNetworkClientServer" />
    <DeviceCapability Name="microphone" />
  </Capabilities>

</Package>
